&pinctrl {
	spi1_default: spi1_default {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 1, 9)>,
					<NRF_PSEL(SPIM_SCK, 1, 8)>,
					<NRF_PSEL(SPIM_MISO, 1, 7)>;
		};
	};

	spi1_sleep: spi1_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 1, 9)>,
					<NRF_PSEL(SPIM_SCK, 1, 8)>,
					<NRF_PSEL(SPIM_MISO, 1, 7)>;
		};
	};
};

&i2c1 {
	status = "disabled";
};

&spi1 {
	status = "okay";
	cs-gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep"; 

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
		spi-max-frequency = <DT_FREQ_M(25)>;
	};
};
